local function RainbowColor(t)
    local r = math.sin(t * 1.5) * 0.5 + 0.5
    local g = math.sin(t * 1.5 + 2) * 0.5 + 0.5
    local b = math.sin(t * 1.5 + 4) * 0.5 + 0.5
    return Color3.new(r, g, b)
end


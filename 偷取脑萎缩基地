local function makeBtn(text, cb)
    local b = Instance.new("TextButton", content)
    b.Size = UDim2.new(0.92, 0, 0, 28)
    b.Text = text
    b.BackgroundColor3 = XION.Mid
    b.BackgroundTransparency = 0.4
    b.TextColor3 = XION.White
    b.Font = Enum.Font.GothamBold
    b.TextSize = 11
    b.BorderSizePixel = 0
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 7)
    local s = Instance.new("UIStroke", b)
    s.Color = XION.Main
    s.Thickness = 1
    s.Transparency = 0.6
    b.MouseButton1Click:Connect(cb)
end

local function makeToggle(text, default, cb)
    local t = Instance.new("TextButton", content)
    t.Size = UDim2.new(0.92, 0, 0, 28)
    t.Text = ""
    t.BackgroundTransparency = 1

    local lbl = Instance.new("TextLabel", t)
    lbl.Size = UDim2.new(0.7, 0, 1, 0)
    lbl.Position = UDim2.new(0.06, 0, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.TextColor3 = XION.White
    lbl.TextSize = 11
    lbl.Font = Enum.Font.GothamBold
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Text = text

    local dot = Instance.new("Frame", t)
    dot.Size = UDim2.new(0, 14, 0, 14)
    dot.Position = UDim2.new(0.85, 0, 0, 7)
    Instance.new("UICorner", dot).CornerRadius = UDim.new(0, 7)

    local state = default
    local function refresh()
        dot.BackgroundColor3 = state and XION.Bright or XION.Border
    end
    refresh()

    t.MouseButton1Click:Connect(function()
        state = not state
        refresh()
        cb(state)
    end)
end

makeBtn("传送最稀有", function()
    local all = scanAll()
    if #all > 0 then
        hrp.CFrame = all[1].part.CFrame + Vector3.new(0, 3, 0)
        infoText.Text = "已传送: " .. all[1].name .. " [" .. all[1].rarity .. "]"
    else
        infoText.Text = "没有目标"
    end
end)

makeToggle("秒互动+自动收集", false, function(state)
    autoOn = state
    if state then
        startAutoFire()
        collecting = true
        infoText.Text = "自动收集中..."
        task.spawn(function()
            while collecting do
                local ok, all = pcall(scanAll)
                if not ok or #all == 0 then
                    task.wait(0.6)
                else
                    local t = all[1]
                    hrp.CFrame = t.part.CFrame + Vector3.new(0, 3, 0)
                    task.wait(0.1)
                    pcall(function() fireproximityprompt(t.prompt) end)
                    task.wait(0.5)
                    if autoHome and homePos then
                        hrp.CFrame = CFrame.new(homePos + Vector3.new(0, 5, 0))
                    end
                    if itemStillThere(t.item) then
                        infoText.Text = "未消失,已回家换下一个"
                    else
                        infoText.Text = "已拿起: " .. t.name
                    end
                    task.wait(0.3)
                end
            end
        end)
    else
        collecting = false
        stopAutoFire()
        infoText.Text = "已停止"
    end
end)

makeToggle("拿起自动回家", true, function(state)
    autoHome = state
end)

